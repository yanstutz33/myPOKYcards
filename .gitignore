# Bancos gerados pelo pipeline — reproduzíveis, grandes e mudam a cada
# rebuild. Reconstrua com ingest_tcgdex.py + build_hash_index.py.
data/*.db
data/*.db-wal
data/*.db-shm
data/*.log
data/*.err

# EXCEÇÃO: o histórico de preço é versionado de propósito. É a única coisa
# insubstituível do projeto — um dia não coletado é perdido para sempre —
# e comprimido dá 0,32 MB.
!data/price_history.csv.gz

# Índice exportado para o navegador e imagens de teste: derivados dos bancos
# acima, gerados por export_web_index.py. ~4 MB que mudam a cada rebuild.
web/data/
web/test/

# Credenciais de API (Scrydex, afiliados de marketplace). Nunca versionar.
.env
.env.*
!.env.example
*.key
secrets/

__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

.DS_Store
Thumbs.db

# copias de seguranca dos bancos, feitas antes de rodadas de indexacao
data/*.bak
